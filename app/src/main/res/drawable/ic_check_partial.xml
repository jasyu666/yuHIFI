<?xml version="1.0" encoding="utf-8"?>
<!--
  半选。文件夹里只勾了一部分歌时用它。

  ★ 三态（全选/半选/未选）不是"讲究"，是**必需**的：
    文件夹勾选会把里面的歌全选上，如果半选也显示成空心圈，
    用户就不知道点一下是"全选"还是"再来一次全取消"。

  ★★ 横线必须是**镂空**（`fillType="evenOdd"`），理由和 ic_check_on 的对勾一样：
     渲染走 `imageTintList`，会把圆和横线染成同一个颜色 ——
     白横线在绿圆上等于消失，**半选就长得和全选一模一样了**，
     上面那條"必需"直接作废。

  ★ 轮廓是把 `M7.5,12 L16.5,12`（strokeWidth 2.2、圆头）外扩出来的矩形。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
        android:pathData="M12,3 A9,9 0 1 1 11.99,3 Z M6.4,10.9 L17.6,10.9 L17.6,13.1 L6.4,13.1 Z" />
</vector>
