<?xml version="1.0" encoding="utf-8"?>
<!--
  通用曲目列表页 —— 「所有歌曲」/「专辑详情」/「歌单详情」三处共用。

  ★ 三处的差别只有"数据从哪来"和"能不能编辑"，列表本身长得一模一样。
    各写一个页面的话，封面大小、徽章样式、空态文案迟早会各走各的。

  ★ 右侧 IndexBar 和中间的字母气泡都**常驻在布局里**，由代码决定显不显示，
    而不是按需 addView —— 运行时增删 View 会让 RecyclerView 重新测量，
    滚动位置有可能被重置。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootTrackList"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ══ 顶栏 ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnTlBack"
            style="@style/Btn.Icon.Back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTlTitle"
                style="@style/Text.Screen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tvTlSubtitle"
                style="@style/Text.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <!--
          多选入口。和「全选」占同一个位置、互相切换显隐 ——
          顶栏本来就不宽（音乐库那边已经有导入/新建/设置三个按钮），
          再塞一个常驻按钮会把标题挤没。
        -->
        <!--
          文字按钮，跟同一排的「导入 / 新建 / 设置」一个样式。

          ★ 之前这里用的是描边图标。浅色顶栏上细描边的方框勾几乎看不见 ——
            不是对比度不够，是那套图标的线宽是照着"画在深色底上"定的。
            整排按钮里混一个不同材质的东西也显得突兀。
        -->
        <Button
            android:id="@+id/btnSelect"
            style="@style/Btn.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_select" />

        <Button
            android:id="@+id/btnSelectAll"
            style="@style/Btn.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_select_all"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnTlAction"
            style="@style/Btn.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnTlMore"
            style="@style/Btn.Icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/glyph_more"
            android:src="@drawable/ic_more"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ══ 列表 + 字母索引 ══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1">

        <!--
          ★ paddingBottom 是 68dp 而不是 4dp，是给下面那个定位按钮留的。

            按钮浮在列表右下角，离底 16dp、直径 48dp —— 加起来 64dp，
            再留 4dp 原来那点边距。不留的话，列表滚到底时**最后一行
            右侧的规格徽章会被按钮永久盖住**（滚到底就滚不动了，没有
            办法把它挪出来）。clipToPadding=false 让这截留白只在
            "滚到底"时才出现，短列表看不出任何区别。
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTracks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_flat"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="68dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvTlEmpty"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_flat"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:padding="32dp"
            android:textAlignment="center"
            android:visibility="gone" />

        <!-- 按住字母滑动块时中间那个大气泡。它比滑动块本身显眼得多，
             因为手指按在右边时，视线是落在屏幕中间的 -->
        <TextView
            android:id="@+id/tvIndexBubble"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_index_bubble"
            android:gravity="center"
            android:textColor="@color/on_brand"
            android:textSize="30sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.hifiprobe.IndexBar
            android:id="@+id/indexBar"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:visibility="gone" />

        <!--
          「定位到正在播放」。只在歌单和「所有歌曲」两个来源里出现
          （专辑来源由代码收起来，见 renderEmpty）。

          ★ 默认的 16dp 右边距会让它压住上面那条字母滑动块 ——
            滑动块占满整条右边缘，最下面几个字母正好在按钮底下。
            代码里会把右边距改成 34dp 让开，见 LocateCurrent.avoidIndexBar。
            所以这里的 marginEnd 只是个初始值，真正生效的是代码设的那个。
        -->
        <ImageButton
            android:id="@+id/btnLocate"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_locate"
            android:contentDescription="@string/action_locate_current"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_locate"
            android:tint="@color/on_brand"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/view_mini_bar" />
    <!-- 多选时的操作栏。和上面的迷你播放条互斥，两者不会同时出现 -->
    <include layout="@layout/view_selection_bar" />

</LinearLayout>
