<?xml version="1.0" encoding="utf-8"?>
<!--
  专辑页。网格铺开，一屏能扫到六到八张。

  ★★ 根布局上的 focusableInTouchMode 不能删。

     这一页有个搜索框，而 EditText 是全页**唯一** focusableInTouchMode 的控件 ——
     进页面时窗口会顺着这条找"谁该拿初始焦点"，找到它就把软键盘弹起来。
     用户只是想翻专辑，一进来先挨一记键盘。

     根布局自己声明成 touch 模式下可聚焦，初始焦点就落在它身上，
     键盘要等手指真的点到搜索框才出来。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootAlbums"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnAlbumsBack"
            style="@style/Btn.Icon.Back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 多选时这里会被换成「已选 N 项」，所以需要一个 id -->
            <TextView
                android:id="@+id/tvAlbumsHeading"
                style="@style/Text.Screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_albums"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tvAlbumsCount"
                style="@style/Text.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="" />
        </LinearLayout>

        <!--
          文字按钮，跟同一排的「导入 / 新建 / 设置」一个样式。

          ★ 之前这里用的是描边图标。浅色顶栏上细描边的方框勾几乎看不见 ——
            不是对比度不够，是那套图标的线宽是照着"画在深色底上"定的。
            整排按钮里混一个不同材质的东西也显得突兀。
        -->
        <Button
            android:id="@+id/btnSelect"
            style="@style/Btn.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_select" />

        <Button
            android:id="@+id/btnSelectAll"
            style="@style/Btn.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_select_all"
            android:visibility="gone" />
    </LinearLayout>

    <!--
      搜索框。**替代**了原来设想的右侧字母索引。

      ★ 字母索引在专辑页效果不好：它只认**第一个字的首字母**，而专辑名
        十有八九是中文 —— 用户想找「范特西」，得先知道它归在 F 还是 T 下面
        （拼音是 F，但按笔画/英文名的人会去找 T）。字母条本身还不带搜索，
        敲不了字。直接按专辑名/歌手名做**子串过滤**，输入什么都能中。

      ★ 只按名字和歌手过滤，**不搜曲目名** —— 这一页列的是专辑，
        搜到一张"里面有一首歌叫这个"的专辑，用户点进去还得再找一遍。
    -->
    <LinearLayout
        android:id="@+id/rowAlbumSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_flat"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="2dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            android:tint="@color/text_tertiary" />

        <EditText
            android:id="@+id/etAlbumSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center_vertical"
            android:hint="@string/hint_search_album"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnSearchClear"
            style="@style/Btn.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/action_clear_search"
            android:src="@drawable/ic_close"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAlbums"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_flat"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvAlbumsEmpty"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_flat"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:padding="32dp"
            android:text="@string/empty_albums"
            android:textAlignment="center"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/view_mini_bar" />

    <!-- 多选时的操作栏。队列页本来就显示着队列，没有迷你播放条要让位 -->
    <include layout="@layout/view_selection_bar" />

</LinearLayout>
