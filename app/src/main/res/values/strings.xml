    <!-- 传输状态 -->
    <string name="state_passthrough">直通 · bit-perfect</string>
    <!--
      系统音频（AAudio）那条路。**不是** bit-perfect，所以不能复用上面那条 ——
      它经过 AudioFlinger 混音，走蓝牙时还有一层真有损的编码。
    -->
    <string name="state_system_audio">系统音频 · 非 bit-perfect</string>
    <!--
      状态条只当**输出方式指示**用，不做设备连接状态报告。
      ★ 刻意不写"非 bit-perfect"：那条路本来就是这样，天天顶着一句免责声明
        只会变成噪音 —— 想知道细节的人去看设置页里那段说明。
    -->
    <string name="device_system_audio">系统音频</string>
    <!--
      直连时带上型号 —— 这时"哪台设备在独占"是有用的信息。
      系统音频那边**不带**：那条路可能走蓝牙、外放，报一个 USB 型号反而误导。
    -->
    <string name="device_usb_direct">USB 直连</string>
    <string name="device_usb_direct_fmt">USB 直连 · %1$s</string>

    <!-- 交叉馈送。档位名和状态条那截都从这儿来，别在 Kotlin 里再写一份 -->
    <string name="crossfeed_fmt">交叉馈送 · %1$s</string>

    <!--
      开了交叉馈送时的徽章文案。

      ★ 直通那条**必须去掉「bit-perfect」** —— 交叉馈送就是在改送往 DAC 的样本，
        还写着 bit-perfect 就是撒谎。颜色也跟着从 ok 降成 neutral。
      ★ 系统音频那条本来就没有 bit-perfect 可言，所以只换掉后半截。
    -->
    <string name="volume_control">音量</string>
    <!--
      可调范围的上/下端点。定义的是**滑条的两头** —— 拖到头也只会到上限，
      不是 0dB。用户设它就是为了"手一滑不至于炸耳朵"。
    -->
    <string name="volume_ceiling">上限</string>
    <string name="volume_floor">下限</string>
    <!--
      DSD 警告。

      ★★ 这个用 error 色而不是普通灰 hint —— 它不是补充说明，
         是"这个功能对一整类文件完全无效"。不写醒目点，
         用户放 DSD 时发现滑条不动，会当成 bug 报回来。
    -->
    <string name="volume_dsd_warning">DSD 原生播放（dsf / dff）不经过 PCM，音量控制对其无效 —— 播放 DSD 时滑条与输入框均不起作用。</string>
    <!--
      音量锁。锁上之后滑条和输入框都变灰不可动（用户 2026-09-29 选的是 A）。

      ★ 锁是"权限"不是"范围" —— 和上限/下限不是一回事：
        上限管"最多能调到哪"，锁管"能不能调"。
    -->
    <string name="volume_lock">音量锁</string>
    <!-- 锁上时播放页数值那一格的字头。★ 光变灰不够，得让人看出是"锁着"而不是"坏了" -->
    <string name="volume_locked_prefix">已锁定</string>
    <!-- 设置页锁上时的说明 -->
    <string name="volume_locked_hint">已锁定 —— 三根滑条与三个输入框均已锁定。如需调整，请先关闭「音量锁」。</string>

    <!--
      后台无限制（2026-09-29 加）。

      ★ 这一项**不是锦上添花的提示**，是后台播放的前置条件：
        不设置的话系统会在后台把进程杀掉，音乐就断了。
      ★ 用户定的是「给出提示」而不是跳转 —— 小米那套厂商页面点不准，
        跳错地方比不跳更让人困惑。所以这里是**把路径写清楚**。
    -->
    <string name="bg_unrestricted">后台无限制</string>
    <string name="bg_unrestricted_title">确保后台播放不被系统终止</string>
    <string name="bg_unrestricted_msg">若未设置，系统将在后台终止 yuHIFI，播放随之中断。

小米 / HyperOS：
  设置 → 应用管理 → yuHIFI → 省电策略 → 无限制
  并在同一页面开启「自启动」

其他机型：
  设置 → 电池 → 电池优化 → 找到 yuHIFI → 不优化

★ 本页读到的状态在小米机型上不一定准确 —— 请以系统中实际显示为准。</string>
    <string name="action_app_details">打开应用详情页</string>
    <string name="action_reconnect">重新连接</string>
